{
  "name": "terminal-hub",
  "version": "1.1.1",
  "description": "All your terminals in one calm window. A macOS terminal app with a sidebar of tabs, split panes, snippets, and tabs that come back after a restart.",
  "keywords": [
    "terminal",
    "terminal-emulator",
    "macos",
    "electron",
    "xterm",
    "node-pty",
    "tabs",
    "split-panes",
    "developer-tools"
  ],
  "homepage": "https://github.com/MohdAbuRezeq/TerminalHub#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MohdAbuRezeq/TerminalHub.git"
  },
  "bugs": {
    "url": "https://github.com/MohdAbuRezeq/TerminalHub/issues"
  },
  "license": "MIT",
  "author": "Mohammad Abu Rezeq",
  "engines": {
    "node": ">=18"
  },
  "main": "main.js",
  "bin": {
    "terminalhub": "./bin/terminalhub.js"
  },
  "scripts": {
    "build": "esbuild renderer/renderer.js --bundle --outfile=renderer/bundle.js --platform=browser --format=iife --external:electron",
    "start": "npm run build && electron .",
    "rebuild": "electron-rebuild -f -w node-pty",
    "postinstall": "(electron-rebuild -f -w node-pty || true) && node scripts/fix-pty-permissions.js",
    "test": "node --test",
    "package": "npm run build && node scripts/fix-pty-permissions.js && electron-packager . TerminalHub --platform=darwin --arch=arm64 --out=dist --overwrite --icon=assets/icon.icns --app-bundle-id=com.terminalhub.app --prune=true --asar.unpackDir=node_modules/node-pty"
  },
  "dependencies": {
    "@fontsource-variable/figtree": "^5.3.0",
    "@fontsource/cascadia-mono": "^5.3.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-search": "^0.15.0",
    "@xterm/addon-web-links": "^0.11.0",
    "@xterm/xterm": "^5.5.0",
    "electron-store": "^8.1.0",
    "node-pty": "^1.0.0"
  },
  "devDependencies": {
    "@electron/packager": "^19.1.0",
    "electron": "^33.0.0",
    "electron-rebuild": "^3.2.9",
    "esbuild": "^0.28.0"
  }
}
